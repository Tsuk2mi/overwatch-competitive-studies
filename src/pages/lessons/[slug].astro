---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { getLessons, lessonUrl, pad, author, sitePath } from '../../lib/lessons';
export async function getStaticPaths() { return (await getLessons()).map(entry => ({ params: { slug: entry.data.slug }, props: { entry } })); }
const { entry } = Astro.props;
const { data } = entry;
const all = await getLessons();
const index = all.findIndex(e => e.id === entry.id);
const previous = all[index - 1];
const next = all[index + 1];
const published = data.status === 'published';
const { Content, headings } = await render(entry);
const toc = headings.filter(h => h.depth === 2 || h.depth === 3);
---
<Base title={data.title} description={data.description || `${data.title}，待发布。`} article={published} updatedAt={data.updatedAt}>
  <article class:list={['lesson', { 'lesson-pending': !published }]}>
    <header class="lesson-hero wrap"><a class="back-link" href={sitePath('/lessons/')}>← 课程目录</a><div class="lesson-heading"><div><p class="eyebrow accent">LESSON {pad(data.lesson)} / {data.englishTitle}</p><h1>{data.title}</h1>{data.description && <p class="lesson-deck">{data.description}</p>}<div class="lesson-meta"><span class:list={['status', { published }]}>{published ? '已发布' : data.contentState === 'awaiting-source' ? '正文待接入' : '待发布'}</span><span>{author}</span>{published && <><span>{data.readingTime} 分钟阅读</span><span>更新于 {data.updatedAt}</span></>}</div></div><span class="lesson-big-number" aria-hidden="true">{pad(data.lesson)}</span></div></header>
    {published ? <div class="reader-grid wrap"><aside class="toc-desktop"><p class="eyebrow">IN THIS LESSON</p><nav aria-label="本课章节目录"><ol>{toc.map(h => <li class:list={{ 'toc-sub': h.depth === 3 }}><a class="toc-link" href={`#${h.slug}`}>{h.text}</a></li>)}</ol></nav><a class="toc-top" href="#main">回到顶部 ↑</a></aside><div class="reader-main"><details class="toc-mobile"><summary>本课目录 <span aria-hidden="true">＋</span></summary><nav aria-label="手机本课目录"><ol>{toc.map(h => <li class:list={{ 'toc-sub': h.depth === 3 }}><a class="toc-link" href={`#${h.slug}`}>{h.text}</a></li>)}</ol></nav></details><div class="prose lesson-body" id="lesson-body"><Content /></div>{data.concepts.length > 0 && <section class="core-concepts" aria-labelledby="core-concepts"><p class="eyebrow accent">KEY CONCEPTS</p><h2 id="core-concepts">本课核心概念</h2><ul>{data.concepts.map(c => <li>{c}</li>)}</ul></section>}<div class="reading-end"><span class="eyebrow">END OF LESSON {pad(data.lesson)}</span><a href="#main">回到顶部 ↑</a></div></div></div> : <section class="coming-soon wrap"><span class="eyebrow accent">COMING SOON</span><h2>留一页，给下一次理解。</h2><p>{data.notice || '本课正式正文尚未完成，确认后将在此发布。'}</p><a class="text-link" href={sitePath('/lessons/04-teamfight/')}>先阅读已发布课程 ↗</a></section>}
    <nav class="lesson-pagination wrap" aria-label="上下课导航">{previous ? <a href={lessonUrl(previous.data.slug)}><span class="eyebrow">← PREVIOUS / LESSON {pad(previous.data.lesson)}</span><span>{previous.data.title}</span></a> : <a href={sitePath('/lessons/')}><span class="eyebrow">← COURSE INDEX</span><span>返回课程目录</span></a>}{next ? <a class="next" href={lessonUrl(next.data.slug)}><span class="eyebrow">NEXT / LESSON {pad(next.data.lesson)} →</span><span>{next.data.title}</span></a> : <a class="next" href={sitePath('/lessons/')}><span class="eyebrow">COURSE INDEX →</span><span>查看全部课程</span></a>}</nav>
  </article>
  {published && <script>
    const body = document.querySelector<HTMLElement>('#lesson-body');
    const bar = document.querySelector<HTMLElement>('#reading-progress');
    const links = [...document.querySelectorAll<HTMLAnchorElement>('.toc-link')];
    const headings = [...document.querySelectorAll<HTMLElement>('#lesson-body h2, #lesson-body h3')];
    let scheduled = false;
    function update() {
      if (!body || !bar) return;
      const start = body.getBoundingClientRect().top + window.scrollY;
      const length = Math.max(1, body.offsetHeight - window.innerHeight * 0.5);
      const fraction = Math.min(1, Math.max(0, (window.scrollY - start + 120) / length));
      bar.style.transform = `scaleX(${fraction})`;
      let active = headings[0];
      for (const heading of headings) { if (heading.getBoundingClientRect().top <= 160) active = heading; }
      for (const link of links) {
        const match = decodeURIComponent(link.hash.slice(1)) === active?.id;
        link.classList.toggle('active', match);
        if (match) link.setAttribute('aria-current', 'location'); else link.removeAttribute('aria-current');
      }
      scheduled = false;
    }
    window.addEventListener('scroll', () => { if (!scheduled) { scheduled = true; requestAnimationFrame(update); } }, { passive: true });
    window.addEventListener('resize', update);
    for (const link of links) link.addEventListener('click', () => { document.querySelector<HTMLDetailsElement>('.toc-mobile')?.removeAttribute('open'); });
    for (const table of document.querySelectorAll('#lesson-body table')) {
      const scroll = document.createElement('div'); scroll.className = 'table-scroll'; scroll.tabIndex = 0;
      scroll.setAttribute('role', 'region'); scroll.setAttribute('aria-label', '阵容体系比较表，可横向滚动');
      table.parentNode?.insertBefore(scroll, table); scroll.appendChild(table);
    }
    update();
  </script>}
</Base>
